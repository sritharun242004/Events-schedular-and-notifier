# ── Auth.js ──────────────────────────────────────────────
# Generate a secret:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google OAuth (from Google Cloud Console → Credentials → OAuth client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# In production set this to your Vercel URL, e.g. https://your-app.vercel.app
# Leave unset locally (defaults to http://localhost:3000).
# AUTH_URL=

# ── Database (PostgreSQL) ────────────────────────────────
# Neon / Vercel Postgres / Supabase connection string.
DATABASE_URL=

# ── Reminders ────────────────────────────────────────────
# Resend API key (https://resend.com) for reminder emails.
RESEND_API_KEY=
# Verified "from" address, e.g. "Schedule CRM <reminders@yourdomain.com>"
# For quick testing you can use: onboarding@resend.dev
REMINDER_FROM=onboarding@resend.dev

# Secret Vercel uses to authorize the cron endpoint. Any random string.
CRON_SECRET=
